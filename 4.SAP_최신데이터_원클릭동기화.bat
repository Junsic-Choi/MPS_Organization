@echo off
chcp 65001 > nul
title SAP ERP 최신 데이터 원클릭 자동 동기화 (ZPPM6680 + ZPPR6470)
color 0B

echo ==============================================================================
echo   [DN Solutions] SAP ERP 최신 소요 결합 데이터 원스톱 자동 동기화
echo   대상 트랜잭션: ZPPM6680 (1840/1842) + ZPPR6470 (1840/1842 가공품소요)
echo ==============================================================================
echo.
echo [1/2] SAP Logon에 로그인되어 있는지 확인 중...
echo.

node sap_automation\sync_engine.js

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ==============================================================================
    echo   [SUCCESS] 4개 파일(sap_1840, sap_1842, component_1840, component_1842)이
    echo   최신으로 완벽하게 동기화되었습니다!
    echo   대시보드 웹 화면에서 새로고침(F5)하시면 최신 결합이 즉시 반영됩니다.
    echo ==============================================================================
) else (
    echo.
    echo ==============================================================================
    echo   [ERROR] 동기화 중 오류가 발생했습니다.
    echo   SAP Logon이 켜져 있고 로그인되어 있는지 확인해 주세요.
    echo ==============================================================================
)

echo.
pause